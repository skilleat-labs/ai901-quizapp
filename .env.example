PORT=3100
HOST=127.0.0.1
NODE_ENV=development
# 실행 전 직접 정하세요. 강사 암호는 12자 이상입니다.
ADMIN_PASSWORD=
SESSION_SECRET=
# local: 단일 Node 프로세스 개발용. 운영은 azure 필수.
STORAGE_DRIVER=local
DATA_DIR=.data
# Azure App Service 관리 ID + Storage Table Data Contributor 역할 필요
# STORAGE_DRIVER=azure
# TABLE_ENDPOINT=https://YOURACCOUNT.table.core.windows.net
# TABLE_NAME=QuizData
